# Copie para .env nesta pasta (.cursor/skills/sydle/) e preencha.
# Este arquivo pode ser versionado; o .env não.
#
# Não há usuário nem senha. Cada ambiente entra só quando o link for informado.
# O login abre o host dessa URL ({origem}), sem caminho de aplicação.
#
# SYDLE_<CLIENTE>_<AMBIENTE>_URL
# URL termina sem barra: https://<host>/api/1/<aplicacao>

SYDLE_TJCE_DEV_URL=https://tjce-dev.sydle.one/api/1/main
SYDLE_TJCE_HOM_URL=https://tjce-hom.sydle.one/api/1/main
SYDLE_TJCE_PROD_URL=https://tjce.sydle.one/api/1/main
SYDLE_SEMAS_DEV_URL=https://semas-dev.sydle.one/api/1/main
